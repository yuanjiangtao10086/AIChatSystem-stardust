# Copy values into your local environment or secret manager. Do not commit real secrets.
DB_URL=jdbc:mysql://localhost:3306/stardust?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=stardust
DB_PASSWORD=replace-with-a-local-secret
JWT_SECRET_BASE64=replace-with-base64-encoded-random-32-byte-or-longer-secret
JWT_ISSUER=stardust-api
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
REFRESH_TOKEN_PEPPER=replace-with-an-independent-random-secret
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace-with-the-same-32-character-or-longer-python-service-token
AI_SERVICE_CONNECT_TIMEOUT=PT5S
AI_SERVICE_REQUEST_TIMEOUT=PT2M
# AI Provider 凭据引用：管理控制台 /admin/ai 中填写的 credentialRef=env:NAME 会在运行时按
# 部署环境的同名变量解析，只用于生成掩码（如 sk-****1234）。数据库与审计日志都不保存密钥原文，
# 也不接受直接粘贴明文 Key（会被拒绝）。示例（按需启用）：
# OPENAI_API_KEY=replace-with-the-real-provider-key
AI_CONTEXT_SYSTEM_PROMPT=You are a helpful AI assistant.
AI_CONTEXT_DEFAULT_WINDOW=16384
AI_CONTEXT_OUTPUT_RESERVE=2048
AI_CONTEXT_SAFETY_RESERVE=512
AI_CONTEXT_MAX_RECENT_MESSAGES=24
AI_CONTEXT_SUMMARY_TRIGGER_MESSAGES=16
AI_CONTEXT_SUMMARY_TRIGGER_TOKENS=8192
AI_CONTEXT_RECENT_MESSAGE_BUDGET=4096
AI_CONTEXT_KEEP_RECENT_MESSAGES=8
AI_CONTEXT_MAX_SUMMARY_TOKENS=1024
AI_MEMORY_RETRIEVAL_LIMIT=5
AI_MEMORY_RETRIEVAL_CANDIDATE_LIMIT=100
AI_MEMORY_TOKEN_BUDGET=512
AI_RAG_EMBEDDING_MODEL=text-embedding-3-small
AI_RAG_RETRIEVAL_TOP_K=6
AI_RAG_RETRIEVAL_TOKEN_BUDGET=1200
AI_USAGE_QUOTA_TOKENS=2000000
AI_USAGE_QUOTA_COST=20
AI_USAGE_CURRENCY=USD
AI_USAGE_OUTPUT_RESERVE_TOKENS=4096
AI_USAGE_PERIOD_DAYS=30
AI_USAGE_RECONCILE_INITIAL_DELAY_MS=60000
AI_USAGE_RECONCILE_INTERVAL_MS=3600000
AI_USAGE_RESERVE_SWEEP_WINDOW_HOURS=24
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW=PT10M
LOGIN_BLOCK=PT15M
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/files
STORAGE_MAX_FILE_SIZE=25MB
STORAGE_MAX_REQUEST_SIZE=26MB
STORAGE_MAX_FILE_BYTES=26214400
STORAGE_DEFAULT_QUOTA_BYTES=1073741824
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
RATE_LIMIT_STORE=memory
REGISTER_MAX_ATTEMPTS=8
REGISTER_WINDOW=PT10M
REGISTER_BLOCK=PT30M
REFRESH_MAX_ATTEMPTS=20
REFRESH_WINDOW=PT5M
REFRESH_BLOCK=PT15M
UPLOAD_MAX_REQUESTS=30
UPLOAD_WINDOW=PT1M
UPLOAD_BLOCK=PT5M
TRUSTED_PROXIES=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PASSWORD_ENCODED=false
