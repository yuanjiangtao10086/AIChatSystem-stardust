STARDUST_AI_ENVIRONMENT=development
STARDUST_AI_LOG_LEVEL=INFO
STARDUST_AI_INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters
STARDUST_AI_PROVIDER_TIMEOUT_SECONDS=60
STARDUST_AI_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
STARDUST_AI_OPENAI_COMPATIBLE_API_KEY=replace-with-provider-api-key
STARDUST_AI_OPENAI_COMPATIBLE_DEFAULT_MODEL=replace-with-provider-model-id
STARDUST_AI_OPENAI_COMPATIBLE_EMBEDDING_MODEL=text-embedding-3-small
STARDUST_AI_RAG_MAX_DOCUMENT_BYTES=26214400
STARDUST_AI_RAG_CHUNK_CHARS=1800
STARDUST_AI_RAG_CHUNK_OVERLAP_CHARS=180
STARDUST_AI_RAG_VECTOR_STORE_PATH=./data/rag-vectors.sqlite3
